root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
# dotnet format's default rule set applies; keep style debates out of PRs.
csharp_style_namespace_declarations = file_scoped:warning

[*.{xml,csproj,props,targets,xaml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2
