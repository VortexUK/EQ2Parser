<Window x:Class="EQ2Parser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQ2Parser" Height="720" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left nav rail -->
        <Border Background="#0B0D13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,16,18">
                    <TextBlock Text="EQ2PARSER" FontFamily="{StaticResource HeadingFont}"
                               Foreground="{StaticResource GoldBrush}" FontSize="19" />
                    <Rectangle Height="1" Margin="0,10,0,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00C8A96E" Offset="0" />
                                <GradientStop Color="#80C8A96E" Offset="0.5" />
                                <GradientStop Color="#00C8A96E" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" DockPanel.Dock="Top"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1" Margin="24,20" Content="{Binding SelectedItem.Page}" />
    </Grid>
</Window>
