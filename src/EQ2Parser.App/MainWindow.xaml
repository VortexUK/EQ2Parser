<Window x:Class="EQ2Parser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQ2Parser" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ACT-style top bar: title + tab strip -->
        <Border Background="#0B0D13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="EQ2PARSER" FontFamily="{StaticResource HeadingFont}"
                           Foreground="{StaticResource GoldBrush}" FontSize="17"
                           VerticalAlignment="Center" Margin="20,0,24,0" />
                <ListBox Grid.Column="1" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TopTabStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Row="1" Margin="18,14" Content="{Binding SelectedItem.Page}" />
    </Grid>
</Window>
