<Application x:Class="EQ2Parser.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EQ2Parser.App.Views"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels"
             ThemeMode="Dark">
    <!-- ThemeMode="Dark" keeps WPF's Fluent (Win11) control theme as the dark
         base; the Lexicon dictionary layers the EQ2Lexicon look on top.
         Startup is manual (App.xaml.cs OnStartup) — no StartupUri. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Lexicon.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <views:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
            <views:InverseBoolConverter x:Key="InverseBool" />

            <!-- ViewModel → View wiring. -->
            <DataTemplate DataType="{x:Type vm:MainParseViewModel}">
                <views:MainParseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SourcesViewModel}">
                <views:SourcesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TriggersViewModel}">
                <views:TriggersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TimersViewModel}">
                <views:TimersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OverlaysViewModel}">
                <views:OverlaysView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RaidViewModel}">
                <views:RaidView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
