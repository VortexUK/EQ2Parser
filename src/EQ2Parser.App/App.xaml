<Application x:Class="EQ2Parser.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EQ2Parser.App.Views"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels"
             ThemeMode="Dark">
    <!-- ThemeMode="Dark" keeps WPF's Fluent (Win11) control theme as the dark
         base; the Lexicon dictionary layers the EQ2Lexicon look on top.
         Startup is manual (App.xaml.cs OnStartup) — no StartupUri. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Lexicon.xaml" />
                <ResourceDictionary Source="Views/MeterRows.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- ViewModel → View wiring. -->
            <DataTemplate DataType="{x:Type vm:LiveViewModel}">
                <views:LiveView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SourcesViewModel}">
                <views:SourcesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" FontSize="14" />
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
