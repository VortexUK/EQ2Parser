<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-10 TFM (not bare -windows) so WinRT speech is projected:
         Windows.Media.SpeechSynthesis carries the modern OneCore/natural
         voices — far better than System.Speech's 2006 SAPI Desktop set. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <StartupObject>EQ2Parser.App.Program</StartupObject>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental in .NET 9/10 —
         it's the documented opt-in; suppress so warnings-as-errors passes.
         NU1701: LiveCharts2's SkiaSharp.Views.WPF/OpenTK dependencies only
         declare .NET Framework TFMs but are assembly-compatible with modern
         WPF — standard suppression for that chart stack. -->
    <NoWarn>$(NoWarn);WPF0001;NU1701</NoWarn>
    <ApplicationIcon>Assets\EQ2Parser.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQ2Parser.Core\EQ2Parser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EQ2Parser.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageReference Include="SharpCompress" Version="0.50.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\EQ2Parser.ico" />
    <!-- WithCulture=false is load-bearing: MSBuild's AssignCulture reads
         the ".de"/".en" pre-extension segment as a CULTURE suffix and
         routes the files into satellite assemblies — the main assembly
         ships with EMPTY dictionaries and every label renders as its raw
         key (the v0.2.5 regression). Verify with
         GetManifestResourceNames after touching this. -->
    <None Remove="Localization\strings.*.json" />
    <EmbeddedResource Include="Localization\strings.*.json" WithCulture="false" />
  </ItemGroup>

</Project>
