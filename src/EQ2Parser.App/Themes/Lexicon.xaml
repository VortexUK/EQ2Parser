<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- EQ2Lexicon palette — mirrors frontend/src/index.css @theme tokens. -->
    <Color x:Key="BgColor">#0F1117</Color>
    <Color x:Key="SurfaceColor">#D11C1F2E</Color>
    <Color x:Key="SurfaceRaisedColor">#E1252840</Color>
    <Color x:Key="BorderColor">#D92E3150</Color>
    <Color x:Key="TextColor">#E2E4F0</Color>
    <Color x:Key="TextMutedColor">#8B90AB</Color>
    <Color x:Key="GoldColor">#C8A96E</Color>
    <Color x:Key="GoldBrightColor">#E8D5A3</Color>
    <Color x:Key="GoldDimColor">#A07840</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldBrightBrush" Color="{StaticResource GoldBrightColor}" />
    <SolidColorBrush x:Key="GoldDimBrush" Color="{StaticResource GoldDimColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- The damage-meter bar fill: gold gradient over dark stone. -->
    <LinearGradientBrush x:Key="MeterBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#66A07840" Offset="0" />
        <GradientStop Color="#40C8A96E" Offset="1" />
    </LinearGradientBrush>
    <!-- Fonts — Cinzel (headings) / Spectral (body), both SIL OFL, embedded. -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Fonts/#Cinzel</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#Spectral, Georgia</FontFamily>
    <FontFamily x:Key="BodySemiBoldFont">pack://application:,,,/Fonts/#Spectral SemiBold, pack://application:,,,/Fonts/#Spectral, Georgia</FontFamily>

    <!-- Uppercase gold eyebrow heading (the site's SectionLabel). -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    </Style>

    <!-- The gilded card: gold-tinted edge, soft depth, top hairline. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Pill filter toggle (the site's rounded chip look). -->
    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="999"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="12,4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1AC8A96E" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#33C8A96E" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top tab (site TabButton look: gold underline). -->
    <Style x:Key="TopTabStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="16,10,16,8"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Gold-outline action button. -->
    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="#1AC8A96E" BorderBrush="{StaticResource GoldDimBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#33C8A96E" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
