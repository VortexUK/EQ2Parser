<UserControl x:Class="EQ2Parser.App.Views.TimersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Timers" Style="{StaticResource PageTitle}" Grid.ColumnSpan="2" />

        <!-- ============ left: definitions ============ -->
        <Grid Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="8,4" FontSize="13" />
                <Button Grid.Column="1" Content="Copy all as XML" Style="{StaticResource GoldButton}"
                        Margin="8,0,0,0" Command="{Binding CopyAllXmlCommand}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox x:Name="TimerList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Resources>
                            <!-- Category header: click to expand/collapse, and
                                 the drop target when dragging a timer. -->
                            <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4"
                                        Margin="0,3,0,1" Padding="8,6" AllowDrop="True" Cursor="Hand"
                                        MouseLeftButtonUp="CategoryHeader_Click"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Width="16" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldDimBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                   FontFamily="{StaticResource BodySemiBoldFont}"
                                                   Foreground="{StaticResource GoldBrightBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" on" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Timer row: drag by the grip to re-file it. -->
                            <DataTemplate DataType="{x:Type vm:TimerDefRow}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="4,8,8,8" Margin="16,0,0,0" AllowDrop="True"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⠿" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll"
                                                   ToolTip="Drag to another category" Background="Transparent"
                                                   PreviewMouseLeftButtonDown="DragGrip_MouseDown"
                                                   PreviewMouseMove="DragGrip_MouseMove"
                                                   PreviewMouseLeftButtonUp="DragGrip_MouseUp" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <Border Grid.Column="2" Width="10" Height="10" CornerRadius="2" Background="{Binding ColorBrush}"
                                                VerticalAlignment="Top" Margin="0,5,10,0" />
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       FontFamily="{StaticResource BodySemiBoldFont}"
                                                       Foreground="{StaticResource GoldBrightBrush}" />
                                            <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource MutedText}"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="▶" Style="{StaticResource GoldButton}" Padding="8,3"
                                                    ToolTip="Test: start this timer now (watch the preview / overlay)"
                                                    Command="{Binding DataContext.TestRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Edit" Style="{StaticResource GoldButton}" Padding="10,3" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="⧉" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="Copy as ACT share XML"
                                                    Command="{Binding DataContext.CopyRowXmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="Delete timer"
                                                    Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasTimers, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="No spell timers yet" FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Create one on the right, or paste ACT share XML (&lt;Spell … /&gt; lines) into the import box. Triggers with a timer hook start these bars by name."
                                   Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                                   TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ right: overlay + editor + import + live preview ============ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="In-game overlay" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ToggleButton Style="{StaticResource PillToggle}" Content="Show overlay"
                                          IsChecked="{Binding OverlayVisible}" />
                            <ToggleButton Style="{StaticResource PillToggle}" Content="Lock (click-through)"
                                          IsChecked="{Binding OverlayLocked}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Unlocked: drag the overlay anywhere over the game, then lock it — locked it ignores clicks entirely and hides itself while no timer runs." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionLabel}" />

                        <TextBlock Text="Name (matches the ability / trigger timer name)" Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,10,0,3" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Category" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Length" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Warn" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding WarningSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Remove at" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="Seconds remaining when the bar disappears — negative keeps it counting past zero" />
                                <TextBox Text="{Binding RemoveSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bar colour" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding ColorChoices}" SelectedIndex="{Binding ColorChoice}"
                                          Width="110" FontSize="13" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Margin="12,14,0,0">
                                <CheckBox Content="only mine" IsChecked="{Binding RestrictToMe}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Restrict to the white list (you): only your casts start it" />
                                <CheckBox Content="one at a time" IsChecked="{Binding AbsoluteTiming}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Ignore timer restarts while time is left" />
                                <CheckBox Content="category lock" IsChecked="{Binding RestrictToCategory}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Only start when the attacker, victim, or zone matches the category" />
                                <CheckBox Content="restart only" IsChecked="{Binding OnlyMasterTicks}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Do not use DoT ticks: every hit restarts the timer instead of adding sub-bars" />
                                <CheckBox Content="allow timer mods" IsChecked="{Binding Modable}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Recast mods on the caster scale this timer's duration when it starts (final = base × (1 + mods))" />
                                <CheckBox Content="radial" IsChecked="{Binding RadialDisplay}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Show as a radial dial (when the timer window supports it)" />
                            </WrapPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,4">
                                <CheckBox Content="panel A" IsChecked="{Binding Panel1}" FontSize="12"
                                          ToolTip="Show in timer panel A (the overlay). Panel B arrives with the mini timer window." />
                                <CheckBox Content="panel B" IsChecked="{Binding Panel2}" FontSize="12" Margin="10,0,0,0"
                                          ToolTip="Reserved for the second timer panel — imported state is kept" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tooltip / note" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Tooltip, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Start sound (text or WAV path)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding StartSound, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Warning sound" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                <TextBox Text="{Binding WarningSound, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save timer" Style="{StaticResource GoldButton}" Command="{Binding SaveTimerCommand}" />
                            <Button Content="Clear" Style="{StaticResource GoldButton}" Margin="8,0,0,0" Command="{Binding NewTimerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Import from ACT" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Paste ACT share XML — &lt;Spell … /&gt; and &lt;Trigger … /&gt; lines both work."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,6" />
                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12" Padding="8,5" AcceptsReturn="True"
                                 MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Import" Style="{StaticResource GoldButton}" Command="{Binding ImportXmlCommand}" />
                            <TextBlock Grid.Column="1" Text="{Binding ImportResult}" Style="{StaticResource MutedText}"
                                       FontSize="12" Margin="10,5,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Running timers" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding LiveBars}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Border Height="22" CornerRadius="3" Background="#5A1C1F2E" />
                                        <Border Height="22" CornerRadius="3" Background="{Binding BarBrush}"
                                                Opacity="0.55" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Fraction}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Grid Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding SecondsText}" FontSize="12"
                                                       FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Hit ▶ on a timer to preview it here and on the overlay."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
