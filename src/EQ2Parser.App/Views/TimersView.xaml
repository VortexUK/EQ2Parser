<UserControl x:Class="EQ2Parser.App.Views.TimersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Timers" Style="{StaticResource PageTitle}" Grid.ColumnSpan="2" />

        <!-- ============ left: definitions ============ -->
        <Grid Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="8,4" FontSize="13" />
                <Button Grid.Column="1" Content="+ New timer" Style="{StaticResource GoldButton}"
                        Margin="8,0,0,0" Command="{Binding NewTimerCommand}"
                        ToolTip="Clear the editor to create a fresh timer" />
                <Button Grid.Column="2" Content="Copy all as XML" Style="{StaticResource GoldButton}"
                        Margin="8,0,0,0" Command="{Binding CopyAllXmlCommand}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox x:Name="TimerList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Resources>
                            <!-- Master section divider: Custom vs Lexicon. -->
                            <DataTemplate DataType="{x:Type vm:SectionRow}">
                                <StackPanel Margin="2,12,0,2">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontSize="16"
                                               Foreground="{StaticResource GoldBrightBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- Zone header: top level, grouping only (not a
                                 drop target — drops land on mobs). -->
                            <DataTemplate DataType="{x:Type vm:ZoneRow}">
                                <Border CornerRadius="4" Margin="0,6,0,1" Padding="8,7" Cursor="Hand"
                                        Background="#2E1C1F2E" BorderBrush="#33C8A96E" BorderThickness="1"
                                        MouseLeftButtonUp="ZoneHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Width="16" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" on" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Mob header: click to expand/collapse, and
                                 the drop target when dragging a timer. -->
                            <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4"
                                        Margin="14,3,0,1" Padding="8,6" AllowDrop="True" Cursor="Hand"
                                        MouseLeftButtonUp="CategoryHeader_Click"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Width="16" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldDimBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                   FontFamily="{StaticResource BodySemiBoldFont}"
                                                   Foreground="{StaticResource GoldBrightBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" on" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Timer row: drag by the grip to re-file it. -->
                            <DataTemplate DataType="{x:Type vm:TimerDefRow}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="4,8,8,8" Margin="30,0,0,0" AllowDrop="True"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Background" Value="#1AC8A96E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⠿" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll"
                                                   ToolTip="Drag to another category" Background="Transparent"
                                                   Visibility="{Binding IsLexicon, Converter={StaticResource InverseBoolToVis}}"
                                                   PreviewMouseLeftButtonDown="DragGrip_MouseDown"
                                                   PreviewMouseMove="DragGrip_MouseMove"
                                                   PreviewMouseLeftButtonUp="DragGrip_MouseUp" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <Border Grid.Column="2" Width="10" Height="10" CornerRadius="2" Background="{Binding ColorBrush}"
                                                VerticalAlignment="Top" Margin="0,5,10,0" />
                                        <StackPanel Grid.Column="3" Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonUp="TimerBody_Click"
                                                    ToolTip="Click to edit in the panel on the right">
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       FontFamily="{StaticResource BodySemiBoldFont}"
                                                       Foreground="{StaticResource GoldBrightBrush}" />
                                            <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource MutedText}"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="▶" Style="{StaticResource GoldButton}" Padding="8,3"
                                                    ToolTip="Test: start this timer now (watch the preview / overlay)"
                                                    Command="{Binding DataContext.TestRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="⧉" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="Copy share XML — send it to a friend, they paste it into their Import box"
                                                    Command="{Binding DataContext.CopyRowXmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="Delete timer"
                                                    Visibility="{Binding IsLexicon, Converter={StaticResource InverseBoolToVis}}"
                                                    Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasTimers, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="No spell timers yet" FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Create one on the right, or paste ACT share XML (&lt;Spell … /&gt; lines) into the import box. Triggers with a timer hook start these bars by name."
                                   Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                                   TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ right: overlay + editor + import + live preview ============ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionLabel}" />

                        <TextBlock Text="Name (matches the ability / trigger timer name)" Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,10,0,3"
                                   ToolTip="The ability name exactly as the log spells it — any cast of it (re)starts the countdown.&#10;A trigger with 'starts timer' set to this name starts it too, e.g. off a boss emote." />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />

                        <TextBlock Text="Zone (grouping only)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,3"
                                   ToolTip="Files the timer under this zone in the tree — and breaks ties: when the same mob + ability has a timer in two zones (Mayong in MMIS vs Castle Mistmoore), the zone you're standing in wins.&#10;Leave blank for timers that apply anywhere." />
                        <TextBox Text="{Binding ZoneText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />

                        <TextBlock Text="Damage type (toggle all that apply — first picked leads)" Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,10,0,3"
                                   ToolTip="The schools the ability deals — shown on the timer bar so you know what's incoming (ward the right thing). The first school you toggle is the dominant one and drives the flame colour.&#10;Tag only: it never affects when the timer starts. The curator fills it from measured hits." />
                        <ItemsControl ItemsSource="{Binding DamageSchoolChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  Style="{StaticResource PillToggle}" FontSize="10.5" Padding="8,2"
                                                  Margin="0,0,4,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Control effect" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="The control it applies (stun, stifle, mez…) — shown on the timer bar so you know WHAT lands at zero and can pre-cure or joust.&#10;Tag only: it never affects when the timer starts." />
                                <ComboBox ItemsSource="{Binding ControlEffectChoices}" SelectedItem="{Binding ControlEffectText}" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Category (mob — “a|b” for split mobs)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="The mob this timer belongs to — used for tree grouping, and as the gate when 'category lock' is ticked (names must match the log exactly, articles included: 'a bisected rumbler').&#10;A mob that splits into renamed copies shares one timer via |-separated names: the earth rumbler|bisected rumbler|trisected rumbler" />
                                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <!-- TextWrapping="Wrap" on the narrow numeric boxes: the Fluent
                                 theme's clear (×) button appears on focus and covers the whole
                                 value at this width; Wrap is the template's collapse trigger. -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Length" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="Seconds from one cast to the next — the countdown length.&#10;Use the curator's 'base' figure when swipe mods were in play: the live timer re-stretches itself whenever the mob actually gets swiped." />
                                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Warn" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="Seconds remaining when the bar goes urgent and the warning sound plays.&#10;Pick your reaction time: 10s to pre-ward, 3s for a joust call." />
                                <TextBox Text="{Binding WarningSeconds, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Remove at" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="Seconds remaining when the bar disappears. Negative keeps it counting PAST zero: -15 shows it overdue for 15s.&#10;Useful because bosses hold casts — the ability is still coming even though the countdown ran out." />
                                <TextBox Text="{Binding RemoveSeconds, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,5" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bar colour" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="The bar / dial fill colour in the timer overlay.&#10;Worth a convention: red for raid-wide AoEs, purple for control, green for personal recasts." />
                                <ComboBox ItemsSource="{Binding ColorChoices}" SelectedIndex="{Binding ColorChoice}"
                                          Width="110" FontSize="13" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Margin="12,14,0,0">
                                <CheckBox Content="only mine" IsChecked="{Binding RestrictToMe}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Only starts when YOU cast the ability — everyone else's casts are ignored.&#10;E.g. track your own Harm Touch recast without the other shadowknight's casts restarting your bar. Leave off for boss timers." />
                                <CheckBox Content="one at a time" IsChecked="{Binding AbsoluteTiming}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="While the bar is running, new casts are ignored — it always runs to zero before it can start again.&#10;Use when re-casts mid-window shouldn't reset the prediction (a scripted cycle, or an effect logged once per person it hits)." />
                                <CheckBox Content="category lock" IsChecked="{Binding RestrictToCategory}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Only start when the Category matches the caster, the victim, or the current zone.&#10;This keeps a boss timer that boss's own — another mob casting a same-named ability won't start it. Untick to fire for any caster." />
                                <!-- ACT's "restart only" checkbox is gone: every timer
                                     restarts its one bar now (sub-timers removed engine-
                                     wide); the flag still round-trips in XML for ACT. -->
                                <CheckBox Content="allow timer mods" IsChecked="{Binding Modable}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Recast debuffs stretch the countdown: with Traumatic Swipe on the mob, a 30s timer starts at 45s (base × 1.5), and rescales if the swiper dies.&#10;Tick for boss recasts (store the un-swiped base as Length); untick for fixed-length effects like a stifle duration." />
                                <CheckBox Content="radial" IsChecked="{Binding RadialDisplay}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="Show as a round dial in the dial row at the top of the timer overlay, instead of a bar in the list.&#10;Best kept to the two or three timers you glance at constantly — the main AoE recast, not every DoT." />
                            </WrapPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,4">
                                <CheckBox Content="panel A" IsChecked="{Binding Panel1}" FontSize="12"
                                          ToolTip="Show this timer in the Timers A overlay.&#10;Run both overlays to split, say, boss timers (A) from your personal recasts (B)." />
                                <CheckBox Content="panel B" IsChecked="{Binding Panel2}" FontSize="12" Margin="10,0,0,0"
                                          ToolTip="Show this timer in the Timers B overlay — the second, independently placed timer window (enable it on the Overlays page)." />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tooltip / note" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="Free note shown when hovering the timer's row in the list — strat reminders, cast order, where the number came from." />
                                <TextBox Text="{Binding Tooltip, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Start sound (text or WAV path)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="Played when the timer starts (the ability just landed). Text is spoken aloud; a .wav path is played; just 'tts' speaks the timer's name; empty = silent." />
                                <TextBox Text="{Binding StartSound, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Warning sound" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="Played at the warn mark, before the ability comes back. Same rules: text spoken, .wav played, just 'tts' says '&lt;name&gt; soon', empty = silent." />
                                <TextBox Text="{Binding WarningSound, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save timer" Style="{StaticResource GoldButton}" Command="{Binding SaveTimerCommand}" />
                            <Button Content="Clear" Style="{StaticResource GoldButton}" Margin="8,0,0,0" Command="{Binding NewTimerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Import from ACT" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Paste ACT share XML — &lt;Spell … /&gt; and &lt;Trigger … /&gt; lines both work — or import a full ACT settings export file."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,6" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12" Padding="8,5" AcceptsReturn="True"
                                 MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Import" Style="{StaticResource GoldButton}" Command="{Binding ImportXmlCommand}" />
                            <Button Grid.Column="1" Content="Import XML file…" Style="{StaticResource GoldButton}" Margin="8,0,0,0"
                                    ToolTip="Import an ACT settings export (Config with CustomTriggers + SpellTimers)"
                                    Command="{Binding ImportXmlFileCommand}" />
                            <TextBlock Grid.Column="2" Text="{Binding ImportResult}" Style="{StaticResource MutedText}"
                                       FontSize="12" Margin="10,5,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Running timers" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding LiveBars}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Border Height="22" CornerRadius="3" Background="#5A1C1F2E" />
                                        <Border Height="22" CornerRadius="3" Background="{Binding BarBrush}"
                                                Opacity="0.55" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Fraction}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Grid Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding SwipeText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       ToolTip="Stretched by a recast debuff (e.g. Traumatic Swipe)" />
                                            <TextBlock Grid.Column="2" Text="{Binding SecondsText}" FontSize="12"
                                                       FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Hit ▶ on a timer to preview it here and on the overlay."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
