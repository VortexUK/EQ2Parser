<UserControl x:Class="EQ2Parser.App.Views.TimersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EQ2Parser.App.Localization"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{loc:Tr Timers_Title}" Style="{StaticResource PageTitle}" Grid.ColumnSpan="2" />

        <!-- ============ left: definitions ============ -->
        <Grid Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="8,4" FontSize="13" />
                <Button Grid.Column="1" Content="{loc:Tr Timers_NewTimer}" Style="{StaticResource GoldButton}"
                        Margin="8,0,0,0" Command="{Binding NewTimerCommand}"
                        ToolTip="{loc:Tr Timers_NewTimerTip}" />
                <Button Grid.Column="2" Content="{loc:Tr Timers_CopyAllXml}" Style="{StaticResource GoldButton}"
                        Margin="8,0,0,0" Command="{Binding CopyAllXmlCommand}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox x:Name="TimerList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Resources>
                            <!-- Master section divider: Custom vs Lexicon. -->
                            <DataTemplate DataType="{x:Type vm:SectionRow}">
                                <StackPanel Margin="2,12,0,2">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontSize="16"
                                               Foreground="{StaticResource GoldBrightBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- Zone header: top level, grouping only (not a
                                 drop target — drops land on mobs). -->
                            <DataTemplate DataType="{x:Type vm:ZoneRow}">
                                <Border CornerRadius="4" Margin="0,6,0,1" Padding="8,7" Cursor="Hand"
                                        Background="#2E1C1F2E" BorderBrush="#33C8A96E" BorderThickness="1"
                                        MouseLeftButtonUp="ZoneHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Width="16" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text="{loc:Tr Timers_OnSuffix}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Mob header: click to expand/collapse, and
                                 the drop target when dragging a timer. -->
                            <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4"
                                        Margin="14,3,0,1" Padding="8,6" AllowDrop="True" Cursor="Hand"
                                        MouseLeftButtonUp="CategoryHeader_Click"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Width="16" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldDimBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                   FontFamily="{StaticResource BodySemiBoldFont}"
                                                   Foreground="{StaticResource GoldBrightBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text="{loc:Tr Timers_OnSuffix}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Timer row: drag by the grip to re-file it. -->
                            <DataTemplate DataType="{x:Type vm:TimerDefRow}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="4,8,8,8" Margin="30,0,0,0" AllowDrop="True"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Background" Value="#1AC8A96E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⠿" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll"
                                                   ToolTip="{loc:Tr Timers_DragTip}" Background="Transparent"
                                                   Visibility="{Binding IsLexicon, Converter={StaticResource InverseBoolToVis}}"
                                                   PreviewMouseLeftButtonDown="DragGrip_MouseDown"
                                                   PreviewMouseMove="DragGrip_MouseMove"
                                                   PreviewMouseLeftButtonUp="DragGrip_MouseUp" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <Border Grid.Column="2" Width="10" Height="10" CornerRadius="2" Background="{Binding ColorBrush}"
                                                VerticalAlignment="Top" Margin="0,5,10,0" />
                                        <StackPanel Grid.Column="3" Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonUp="TimerBody_Click"
                                                    ToolTip="{loc:Tr Timers_EditTip}">
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       FontFamily="{StaticResource BodySemiBoldFont}"
                                                       Foreground="{StaticResource GoldBrightBrush}" />
                                            <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource MutedText}"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="▶" Style="{StaticResource GoldButton}" Padding="8,3"
                                                    ToolTip="{loc:Tr Timers_TestTip}"
                                                    Command="{Binding DataContext.TestRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="⧉" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="{loc:Tr Timers_CopyShareTip}"
                                                    Command="{Binding DataContext.CopyRowXmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="{loc:Tr Timers_DeleteTip}"
                                                    Visibility="{Binding IsLexicon, Converter={StaticResource InverseBoolToVis}}"
                                                    Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasTimers, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{loc:Tr Timers_EmptyTitle}" FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Tr Timers_EmptyBody}"
                                   Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                                   TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ right: overlay + editor + import + live preview ============ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionLabel}" />

                        <TextBlock Text="{loc:Tr Timers_NameLabel}" Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,10,0,3"
                                   ToolTip="{loc:Tr Timers_NameTip}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />

                        <TextBlock Text="{loc:Tr Timers_ZoneLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,3"
                                   ToolTip="{loc:Tr Timers_ZoneTip}" />
                        <TextBox Text="{Binding ZoneText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />

                        <TextBlock Text="{loc:Tr Timers_DamageTypeLabel}" Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,10,0,3"
                                   ToolTip="{loc:Tr Timers_DamageTypeTip}" />
                        <ItemsControl ItemsSource="{Binding DamageSchoolChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  Style="{StaticResource PillToggle}" FontSize="10.5" Padding="8,2"
                                                  Margin="0,0,4,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="{loc:Tr Timers_ControlEffectLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_ControlEffectTip}" />
                                <ComboBox ItemsSource="{Binding ControlEffectChoices}" SelectedItem="{Binding ControlEffectText}" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{loc:Tr Timers_CategoryLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_CategoryTip}" />
                                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <!-- TextWrapping="Wrap" on the narrow numeric boxes: the Fluent
                                 theme's clear (×) button appears on focus and covers the whole
                                 value at this width; Wrap is the template's collapse trigger. -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr Timers_LengthLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_LengthTip}" />
                                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr Timers_WarnLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_WarnTip}" />
                                <TextBox Text="{Binding WarningSeconds, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{loc:Tr Timers_RemoveAtLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_RemoveAtTip}" />
                                <TextBox Text="{Binding RemoveSeconds, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,5" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Timers_BarColourLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_BarColourTip}" />
                                <ComboBox ItemsSource="{Binding ColorChoices}" SelectedIndex="{Binding ColorChoice}"
                                          Width="110" FontSize="13" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Margin="12,14,0,0">
                                <CheckBox Content="{loc:Tr Timers_OnlyMine}" IsChecked="{Binding RestrictToMe}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="{loc:Tr Timers_OnlyMineTip}" />
                                <CheckBox Content="{loc:Tr Timers_OneAtATime}" IsChecked="{Binding AbsoluteTiming}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="{loc:Tr Timers_OneAtATimeTip}" />
                                <CheckBox Content="{loc:Tr Timers_CategoryLock}" IsChecked="{Binding RestrictToCategory}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="{loc:Tr Timers_CategoryLockTip}" />
                                <!-- ACT's "restart only" checkbox is gone: every timer
                                     restarts its one bar now (sub-timers removed engine-
                                     wide); the flag still round-trips in XML for ACT. -->
                                <CheckBox Content="{loc:Tr Timers_AllowTimerMods}" IsChecked="{Binding Modable}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="{loc:Tr Timers_AllowTimerModsTip}" />
                                <CheckBox Content="{loc:Tr Timers_Radial}" IsChecked="{Binding RadialDisplay}" FontSize="12" Margin="0,0,10,4"
                                          ToolTip="{loc:Tr Timers_RadialTip}" />
                            </WrapPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,4">
                                <CheckBox Content="{loc:Tr Timers_PanelA}" IsChecked="{Binding Panel1}" FontSize="12"
                                          ToolTip="{loc:Tr Timers_PanelATip}" />
                                <CheckBox Content="{loc:Tr Timers_PanelB}" IsChecked="{Binding Panel2}" FontSize="12" Margin="10,0,0,0"
                                          ToolTip="{loc:Tr Timers_PanelBTip}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Tr Timers_TooltipNoteLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_TooltipNoteTip}" />
                                <TextBox Text="{Binding Tooltip, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="{loc:Tr Timers_StartSoundLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_StartSoundTip}" />
                                <TextBox Text="{Binding StartSound, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="{loc:Tr Timers_WarningSoundLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Timers_WarningSoundTip}" />
                                <TextBox Text="{Binding WarningSound, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:Tr Timers_SaveTimer}" Style="{StaticResource GoldButton}" Command="{Binding SaveTimerCommand}" />
                            <Button Content="{loc:Tr Timers_Clear}" Style="{StaticResource GoldButton}" Margin="8,0,0,0" Command="{Binding NewTimerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Timers_ImportFromAct}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{loc:Tr Timers_ImportHint}"
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,6" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12" Padding="8,5" AcceptsReturn="True"
                                 MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Top-aligned: the result text wraps to many
                                 lines in verbose locales (RU) and the grid
                                 row grows — stretched buttons ballooned. -->
                            <Button Content="{loc:Tr Timers_Import}" Style="{StaticResource GoldButton}" Command="{Binding ImportXmlCommand}"
                                    VerticalAlignment="Top" />
                            <Button Grid.Column="1" Content="{loc:Tr Timers_ImportXmlFile}" Style="{StaticResource GoldButton}" Margin="8,0,0,0"
                                    ToolTip="{loc:Tr Timers_ImportXmlFileTip}"
                                    Command="{Binding ImportXmlFileCommand}"
                                    VerticalAlignment="Top" />
                            <TextBlock Grid.Column="2" Text="{Binding ImportResult}" Style="{StaticResource MutedText}"
                                       FontSize="12" Margin="10,5,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Timers_RunningTimers}" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding LiveBars}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Border Height="22" CornerRadius="3" Background="#5A1C1F2E" />
                                        <Border Height="22" CornerRadius="3" Background="{Binding BarBrush}"
                                                Opacity="0.55" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Fraction}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Grid Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding SwipeText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       ToolTip="{loc:Tr Timers_SwipeTip}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SecondsText}" FontSize="12"
                                                       FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Tr Timers_PreviewHint}"
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
