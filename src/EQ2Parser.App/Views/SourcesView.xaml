<UserControl x:Class="EQ2Parser.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EQ2Parser.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Tr Sources_Title}" Style="{StaticResource PageTitle}" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Sources_AddLiveTail}" Style="{StaticResource GoldButton}" Command="{Binding AddLiveCommand}" />
                <Button Content="{loc:Tr Sources_AddParseExisting}" Style="{StaticResource GoldButton}" Margin="8,0,0,0"
                        Command="{Binding AddWithHistoryCommand}" />
                <Button Content="{loc:Tr Sources_WatchFolder}" Style="{StaticResource GoldButton}" Margin="8,0,0,0"
                        ToolTip="{loc:Tr Sources_WatchFolderTip}"
                        Command="{Binding WatchFolderCommand}" />
                <TextBlock Text="{loc:Tr Sources_ModesHint}"
                           Style="{StaticResource MutedText}" FontSize="12" Margin="16,6,0,0" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding WatchedFolders}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="👁" FontSize="12" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <Button Content="✕" Style="{StaticResource GoldButton}" Padding="8,1" Margin="10,0,0,0"
                                    ToolTip="{loc:Tr Sources_UnwatchTip}"
                                    Command="{Binding DataContext.UnwatchFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Owner}" Foreground="{StaticResource GoldBrightBrush}"
                                                   FontFamily="{StaticResource BodySemiBoldFont}" FontSize="15" />
                                        <Border Background="#26C8A96E" CornerRadius="99" Padding="8,1" Margin="10,2,0,0">
                                            <TextBlock Text="{Binding Mode}" FontSize="10" Foreground="{StaticResource GoldBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12"
                                               Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{loc:Tr Sources_Remove}" Style="{StaticResource GoldButton}"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
