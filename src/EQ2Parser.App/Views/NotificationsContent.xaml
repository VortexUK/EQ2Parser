<UserControl x:Class="EQ2Parser.App.Views.NotificationsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ItemsControl x:Name="Items">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- One toast: opacity is computed per tick (fade-in on
                         arrival, fade-out at end of life). -->
                    <Border CornerRadius="6" Margin="0,2" Padding="10,7" Opacity="{Binding Opacity}"
                            Background="#D9141726" BorderBrush="#66C8A96E" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#C8A96E" Opacity="0.35" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F5E9CF" TextWrapping="Wrap" FontFamily="Segoe UI">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="#000000" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <!-- Same callout repeating collapses into ×N. -->
                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12" FontWeight="Bold"
                                       Foreground="#E8C880" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CountText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyHint" Text="Trigger alerts pop up here for a few seconds."
                   FontSize="11" Foreground="#8B90AB" Margin="1,2" FontFamily="Segoe UI" />
    </StackPanel>
</UserControl>
