<UserControl x:Class="EQ2Parser.App.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0" />
                    <Border Margin="12,4,0,0" VerticalAlignment="Center" CornerRadius="99"
                            Background="#334ADE80" Padding="8,2"
                            Visibility="{Binding InCombat, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LIVE" FontSize="10" Foreground="{StaticResource SuccessBrush}"
                                   FontFamily="{StaticResource BodySemiBoldFont}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="13" />
            </StackPanel>
            <Button Grid.Column="1" Content="End combat" Style="{StaticResource GoldButton}"
                    VerticalAlignment="Top" Command="{Binding EndCombatCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MeterRowTemplate}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
