<UserControl x:Class="EQ2Parser.App.Views.MiniParseContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:EQ2Parser.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
        <!-- Fight header: title left (Cinzel), metric + duration right. -->
        <Grid Margin="1,0,1,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FightTitle" FontFamily="{StaticResource HeadingFont}" FontSize="13"
                       Foreground="#E8D5A3" TextTrimming="CharacterEllipsis">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="#000000" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="RaidValueText" FontSize="12" Foreground="#F0F2FA" FontFamily="Consolas"
                           FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="#000000" Opacity="0.9" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="MetricText" FontSize="9" Foreground="#8B90AB" FontFamily="Segoe UI"
                           VerticalAlignment="Center" Margin="3,1,0,0" />
                <TextBlock x:Name="DurationText" FontSize="12" Foreground="#C8A96E" FontFamily="Consolas"
                           FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Rectangle Height="1" Fill="#3AC8A96E" Margin="0,0,0,4" />
        </StackPanel>

        <ItemsControl x:Name="RowsHost" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Border Height="20" CornerRadius="4" Background="#3D141724" />
                        <Border Height="20" CornerRadius="4" Background="{Binding BarBrush}"
                                Opacity="0.42" RenderTransformOrigin="0,0.5"
                                v:BarAnimation.Fraction="{Binding Fraction}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontFamily="Segoe UI">
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding NameBrush}" FontWeight="SemiBold" /><Run Text="{Binding ClassText, Mode=OneWay}" Foreground="#D6DAE6" FontSize="10.5" />
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="#000000" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding DeathsText}" FontSize="10" Foreground="#F87171"
                                       VerticalAlignment="Center" FontFamily="Segoe UI" Margin="0,0,7,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="#000000" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" Foreground="#F0F2FA"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="#000000" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="{Binding ShareText}" FontSize="10" Foreground="#8B90AB"
                                       VerticalAlignment="Center" FontFamily="Consolas" Margin="7,1,0,0" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="The current fight's meter appears here."
                   FontSize="11" Foreground="#8B90AB" Margin="1,2" FontFamily="Segoe UI" VerticalAlignment="Top" />
    </Grid>
</UserControl>
