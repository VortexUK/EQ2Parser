<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EQ2Parser.App.Views"
                    xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels">

    <views:BarWidthConverter x:Key="BarWidth" />

    <!-- One damage-meter row: gold bar under name/class/dps/damage/%. -->
    <DataTemplate x:Key="MeterRowTemplate" DataType="{x:Type vm:CombatantRow}">
        <Grid Margin="0,1">
            <Border x:Name="BarHost" CornerRadius="4" Background="#0D1C1F2E" MinHeight="26">
                <Border HorizontalAlignment="Left" CornerRadius="4"
                        Background="{StaticResource MeterBarBrush}">
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource BarWidth}">
                            <Binding Path="BarFraction" />
                            <Binding ElementName="BarHost" Path="ActualWidth" />
                        </MultiBinding>
                    </Border.Width>
                </Border>
            </Border>
            <Grid Margin="10,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                           FontFamily="{StaticResource BodySemiBoldFont}" FontSize="14"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ClassName}" Foreground="{StaticResource GoldDimBrush}"
                           FontFamily="{StaticResource BodyFont}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Dps}" Foreground="{StaticResource GoldBrightBrush}"
                           FontFamily="{StaticResource BodySemiBoldFont}" FontSize="14" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding Damage}" Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="{StaticResource BodyFont}" FontSize="13" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding Percent}" Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="{StaticResource BodyFont}" FontSize="12" TextAlignment="Right" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPet}" Value="True">
                <Setter TargetName="BarHost" Property="Opacity" Value="0.55" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
