<Window x:Class="EQ2Parser.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EQ2Parser.App.Localization"
        Title="{loc:Tr Export_Title}" Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Export_Presets}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="PresetCombo" FontSize="12.5" Margin="0,0,0,6"
                              SelectionChanged="Preset_Selected" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PresetNameBox" FontSize="12.5" Margin="0,0,6,0"
                                 ToolTip="{loc:Tr Export_PresetNameTip}" />
                        <Button Grid.Column="1" Content="{loc:Tr Export_SavePreset}" Style="{StaticResource GoldButton}"
                                Padding="10,3" Click="SavePreset_Click" />
                    </Grid>
                    <Button x:Name="DeletePresetButton" Content="{loc:Tr Export_DeletePreset}"
                            HorizontalAlignment="Left" Padding="10,3" FontSize="12"
                            Click="DeletePreset_Click" Visibility="Collapsed" />

                    <TextBlock Text="{loc:Tr Export_SortBy}" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                    <ComboBox x:Name="SortCombo" FontSize="12.5" DisplayMemberPath="Label"
                              SelectionChanged="Spec_Changed" />

                    <TextBlock Text="{loc:Tr Export_Archetypes}" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                    <ItemsControl x:Name="ArchetypeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked}"
                                          Margin="0,3,0,3" Foreground="{StaticResource TextBrush}"
                                          FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                                          Checked="Spec_Changed" Unchecked="Spec_Changed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Tr Export_Columns}" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                    <ItemsControl x:Name="ColumnList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked}"
                                          Margin="0,3,0,3" Foreground="{StaticResource TextBrush}"
                                          FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                                          Checked="Spec_Changed" Unchecked="Spec_Changed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Tr Export_Preview}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" x:Name="PreviewBox" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12.5"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderThickness="0" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="{loc:Tr Export_Copy}" Style="{StaticResource GoldButton}"
                    Padding="16,5" Click="Copy_Click" />
        </StackPanel>
    </Grid>
</Window>
