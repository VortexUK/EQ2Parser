<Window x:Class="EQ2Parser.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EQ2Parser.App.Localization"
        Title="{loc:Tr Export_Title}" Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Export_Columns}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <ItemsControl x:Name="ColumnList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked}"
                                          Margin="0,3,0,3" Foreground="{StaticResource TextBrush}"
                                          FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                                          Checked="Column_Toggled" Unchecked="Column_Toggled" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Tr Export_Preview}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" x:Name="PreviewBox" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12.5"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderThickness="0" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="{loc:Tr Export_Copy}" Style="{StaticResource GoldButton}"
                    Padding="16,5" Click="Copy_Click" />
        </StackPanel>
    </Grid>
</Window>
