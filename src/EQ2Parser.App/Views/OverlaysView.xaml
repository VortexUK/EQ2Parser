<UserControl x:Class="EQ2Parser.App.Views.OverlaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels">
    <UserControl.Resources>
        <!-- One card per overlay window. -->
        <DataTemplate x:Key="OverlayCard" DataType="{x:Type vm:OverlayConfigVm}">
            <Border Style="{StaticResource Card}" Padding="14" Width="300" Margin="0,0,12,12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ToggleButton Style="{StaticResource PillToggle}" Content="Show"
                                      IsChecked="{Binding Visible}" />
                        <ToggleButton Style="{StaticResource PillToggle}" Content="Lock (click-through)"
                                      IsChecked="{Binding Locked}" Margin="8,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Opacity" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.3" Maximum="1" Value="{Binding Opacity}"
                                VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Column="2" Text="{Binding OpacityLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="1" Text="Scale" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.7" Maximum="1.6" Value="{Binding Scale}"
                                VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ScaleLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Text="Width" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="200" Maximum="480" Value="{Binding Width}"
                                VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WidthLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="3" Text="{Binding ItemsLabel}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="3" Maximum="25" Value="{Binding MaxItems}"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MaxItemsLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Overlays" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" MaxWidth="640"
                       HorizontalAlignment="Left" Margin="0,0,0,14"
                       Text="In-game windows that float over EQ2. Show one, drag it into place, then lock it — locked overlays are click-through, never steal focus, and vanish entirely while they have nothing to say. Every change here applies to the live window instantly." />

            <WrapPanel>
                <ContentControl Content="{Binding MiniParse}" ContentTemplate="{StaticResource OverlayCard}" />
                <ContentControl Content="{Binding TimerA}" ContentTemplate="{StaticResource OverlayCard}" />
                <ContentControl Content="{Binding TimerB}" ContentTemplate="{StaticResource OverlayCard}" />
            </WrapPanel>

            <Border Style="{StaticResource Card}" Padding="14" Width="300" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Mini parse metric" Style="{StaticResource SectionLabel}" />
                    <ComboBox ItemsSource="{Binding MetricChoices}" SelectedIndex="{Binding MetricIndex}"
                              Margin="0,8,0,0" Width="140" HorizontalAlignment="Left" FontSize="13" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="DPS, healing, or damage taken. Timers route to panel A or B per timer (the panel checkboxes in each timer's editor)." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
