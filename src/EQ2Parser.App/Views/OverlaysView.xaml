<UserControl x:Class="EQ2Parser.App.Views.OverlaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels"
             xmlns:loc="clr-namespace:EQ2Parser.App.Localization">
    <UserControl.Resources>
        <!-- One card per overlay window. -->
        <DataTemplate x:Key="OverlayCard" DataType="{x:Type vm:OverlayConfigVm}">
            <Border Style="{StaticResource Card}" Padding="14" Width="300" Margin="0,0,12,12"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ToggleButton Style="{StaticResource PillToggle}" Content="{loc:Tr Overlays_Show}"
                                      IsChecked="{Binding Visible}" />
                        <ToggleButton Style="{StaticResource PillToggle}" Content="{loc:Tr Overlays_LockClickThrough}"
                                      IsChecked="{Binding Locked}" Margin="8,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{loc:Tr Overlays_Opacity}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.3" Maximum="1" Value="{Binding Opacity}"
                                VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Column="2" Text="{Binding OpacityLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="1" Text="{loc:Tr Overlays_Scale}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.7" Maximum="1.6" Value="{Binding Scale}"
                                VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ScaleLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Text="{loc:Tr Overlays_Width}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="200" Maximum="480" Value="{Binding Width}"
                                VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WidthLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="3" Text="{Binding ItemsLabel}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"
                                   Visibility="{Binding HasMaxItems, Converter={StaticResource BoolToVis}}" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="3" Maximum="25" Value="{Binding MaxItems}"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,4"
                                Visibility="{Binding HasMaxItems, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MaxItemsLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right"
                                   Visibility="{Binding HasMaxItems, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="4" Text="{loc:Tr Overlays_StayFor}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"
                                   Visibility="{Binding HasToastSeconds, Converter={StaticResource BoolToVis}}" />
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="2" Maximum="30" Value="{Binding ToastSeconds}"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,4"
                                Visibility="{Binding HasToastSeconds, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ToastSecondsLabel}" Foreground="{StaticResource GoldBrush}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Right"
                                   Visibility="{Binding HasToastSeconds, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{loc:Tr Overlays_ResizeHint}"
                               Visibility="{Binding IsResizable, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{loc:Tr Overlays_PageTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" MaxWidth="640"
                       HorizontalAlignment="Left" Margin="0,0,0,14"
                       Text="{loc:Tr Overlays_Intro}" />

            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource OverlayCard}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="640"
                       HorizontalAlignment="Left"
                       Text="{loc:Tr Overlays_FooterHint}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
