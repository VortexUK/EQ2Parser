<UserControl x:Class="EQ2Parser.App.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EQ2Parser.App.Localization"
             xmlns:vm="clr-namespace:EQ2Parser.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{loc:Tr Triggers_Title}" Style="{StaticResource PageTitle}" Grid.ColumnSpan="2" />

        <!-- ============ left: the trigger list ============ -->
        <Grid Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="8,4" FontSize="13" />
                <Button Grid.Column="1" Content="{loc:Tr Triggers_NewTrigger}" Style="{StaticResource GoldButton}"
                        Margin="8,0,0,0" Command="{Binding NewTriggerCommand}"
                        ToolTip="{loc:Tr Triggers_NewTriggerTip}" />
                <Button Grid.Column="2" Content="{loc:Tr Triggers_CopyAllXml}" Style="{StaticResource GoldButton}"
                        Margin="8,0,0,0" Command="{Binding CopyAllXmlCommand}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <!-- ListBox (not ItemsControl) so 300+ imported triggers
                         virtualize; the container style strips selection chrome. -->
                    <ListBox x:Name="TriggerList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Resources>
                            <!-- Master section divider: Custom vs Lexicon. -->
                            <DataTemplate DataType="{x:Type vm:SectionRow}">
                                <StackPanel Margin="2,12,0,2">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontSize="16"
                                               Foreground="{StaticResource GoldBrightBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- Zone header: top level, grouping only (not a
                                 drop target — drops land on mobs). -->
                            <DataTemplate DataType="{x:Type vm:ZoneRow}">
                                <Border CornerRadius="4" Margin="0,6,0,1" Padding="8,7" Cursor="Hand"
                                        Background="#2E1C1F2E" BorderBrush="#33C8A96E" BorderThickness="1"
                                        MouseLeftButtonUp="ZoneHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Width="16" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text="{loc:Tr Triggers_OnSuffix}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Mob/category header: click to expand/collapse,
                                 and the drop target when dragging a trigger. -->
                            <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4"
                                        Margin="14,3,0,1" Padding="8,6" AllowDrop="True" Cursor="Hand"
                                        MouseLeftButtonUp="CategoryHeader_Click"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Width="16" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldDimBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                   FontFamily="{StaticResource BodySemiBoldFont}"
                                                   Foreground="{StaticResource GoldBrightBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text="{loc:Tr Triggers_OnSuffix}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Trigger row: drag by the grip to re-file it.
                                 Highlights while hovered as a drop target
                                 (drop = file into this row's category) and
                                 flashes after landing from a move. -->
                            <DataTemplate DataType="{x:Type vm:TriggerRow}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="4,8,8,8" Margin="30,0,0,0" AllowDrop="True"
                                        DragOver="DropTarget_DragOver" DragLeave="DropTarget_DragLeave" Drop="DropTarget_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Background" Value="#1AC8A96E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="#26C8A96E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⠿" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll"
                                                   ToolTip="{loc:Tr Triggers_DragToCategoryTip}" Background="Transparent"
                                                   Visibility="{Binding IsLexicon, Converter={StaticResource InverseBoolToVis}}"
                                                   PreviewMouseLeftButtonDown="DragGrip_MouseDown"
                                                   PreviewMouseMove="DragGrip_MouseMove"
                                                   PreviewMouseLeftButtonUp="DragGrip_MouseUp" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <StackPanel Grid.Column="2" Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonUp="TriggerBody_Click"
                                                    ToolTip="{loc:Tr Triggers_ClickToEditTip}">
                                            <TextBlock Text="{Binding RegexText}" FontFamily="Consolas" FontSize="13"
                                                       Foreground="{StaticResource GoldBrightBrush}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <!-- Right margin is the separator from the sound label —
                                                     without it "zone-locked" and "Say …" run together. -->
                                                <TextBlock Text="{loc:Tr Triggers_ZoneLocked}" FontSize="10" Margin="0,2,8,0"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Visibility="{Binding ZoneRestricted, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding SoundLabel}" FontSize="11" Margin="0,1,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TimerLabel}" FontSize="11" Margin="8,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkedTimerMissing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="⧉" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="{loc:Tr Triggers_CopyShareXmlTip}"
                                                    Command="{Binding DataContext.CopyRowXmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource GoldButton}" Padding="8,3" Margin="6,0,0,0"
                                                    ToolTip="{loc:Tr Triggers_DeleteTriggerTip}"
                                                    Visibility="{Binding IsLexicon, Converter={StaticResource InverseBoolToVis}}"
                                                    Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasTriggers, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{loc:Tr Triggers_NoTriggersYet}" FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Tr Triggers_NoTriggersHint}"
                                   Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="340"
                                   TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ right: editor + import + recent fires ============ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionLabel}" />

                        <TextBlock Text="{loc:Tr Triggers_RegexLabel}" Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,10,0,3"
                                   ToolTip="{loc:Tr Triggers_RegexTip}" />
                        <TextBox Text="{Binding RegexText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="13" Padding="8,5" TextWrapping="Wrap" AcceptsReturn="False" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="{loc:Tr Triggers_ZoneLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Triggers_ZoneTip}" />
                                <TextBox Text="{Binding ZoneText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="{loc:Tr Triggers_CategoryLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Triggers_CategoryTip}" />
                                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="{loc:Tr Triggers_OnlyInZone}" IsChecked="{Binding RestrictToZone}" Margin="0,8,0,0" FontSize="12"
                                  ToolTip="{loc:Tr Triggers_OnlyInZoneTip}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Triggers_AlertLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Triggers_AlertTip}" />
                                <ComboBox ItemsSource="{Binding SoundChoices}" SelectedIndex="{Binding SoundChoice}" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{loc:Tr Triggers_CooldownLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                           ToolTip="{loc:Tr Triggers_CooldownTip}" />
                                <!-- Wrap collapses the Fluent clear (×) button, which covers
                                     the whole value in a box this narrow. -->
                                <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Width="70" Padding="8,5" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding SoundDataVisible, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <TextBlock Text="{loc:Tr Triggers_WavPathLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                       Visibility="{Binding SoundDataIsWav, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{loc:Tr Triggers_TtsLabel}"
                                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"
                                       Visibility="{Binding SoundDataIsTts, Converter={StaticResource BoolToVis}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SoundData, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontSize="13" />
                                <Button Grid.Column="1" Content="…" Style="{StaticResource GoldButton}" Margin="6,0,0,0" Padding="10,3"
                                        ToolTip="{loc:Tr Triggers_BrowseWavTip}" Command="{Binding BrowseWavCommand}"
                                        Visibility="{Binding SoundDataIsWav, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Column="2" Content="▶" Style="{StaticResource GoldButton}" Margin="6,0,0,0" Padding="10,3"
                                        ToolTip="{loc:Tr Triggers_TestAlertTip}" Command="{Binding TestSoundCommand}" />
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="{loc:Tr Triggers_StartsTimer}" IsChecked="{Binding StartsTimer}" VerticalAlignment="Center" FontSize="12"
                                      ToolTip="{loc:Tr Triggers_StartsTimerTip}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TimerNameChoices}" SelectedItem="{Binding TimerName}"
                                      Margin="10,0,0,0" FontSize="13"
                                      IsEnabled="{Binding StartsTimer}" />
                        </Grid>

                        <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding EditorInfo}" Foreground="{StaticResource SuccessBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:Tr Triggers_SaveTrigger}" Style="{StaticResource GoldButton}" Command="{Binding SaveTriggerCommand}" />
                            <Button Content="{loc:Tr Triggers_Clear}" Style="{StaticResource GoldButton}" Margin="8,0,0,0" Command="{Binding NewTriggerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Triggers_ImportFromAct}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{loc:Tr Triggers_ImportHint}"
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,6" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12" Padding="8,5" AcceptsReturn="True"
                                 MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Top-aligned: the result text wraps to many
                                 lines in verbose locales (RU) and the grid
                                 row grows — stretched buttons ballooned. -->
                            <Button Content="{loc:Tr Triggers_Import}" Style="{StaticResource GoldButton}" Command="{Binding ImportXmlCommand}"
                                    VerticalAlignment="Top" />
                            <Button Grid.Column="1" Content="{loc:Tr Triggers_ImportXmlFile}" Style="{StaticResource GoldButton}" Margin="8,0,0,0"
                                    ToolTip="{loc:Tr Triggers_ImportXmlFileTip}"
                                    Command="{Binding ImportXmlFileCommand}"
                                    VerticalAlignment="Top" />
                            <TextBlock Grid.Column="2" Text="{Binding ImportResult}" Style="{StaticResource MutedText}"
                                       FontSize="12" Margin="10,5,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Triggers_RecentFires}" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding RecentFires}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource GoldDimBrush}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}">
                                            <Run Text="{Binding Category, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" /><Run Text="  " /><Run Text="{Binding Matched, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Tr Triggers_RecentFiresHint}"
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding HasRecentFires, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
