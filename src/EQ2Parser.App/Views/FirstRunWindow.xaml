<Window x:Class="EQ2Parser.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to EQ2Parser" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Welcome to EQ2Parser" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap"
                   Text="To parse your fights, EQ2Parser watches your EverQuest II log folder — any character whose log becomes active is picked up automatically. In game, make sure logging is on (type /log)." />

        <TextBlock Text="Log folder" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
        <ListBox x:Name="CandidateList" MaxHeight="140" SelectionMode="Single"
                 Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource GoldBrightBrush}" Margin="4,3" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="NoCandidatesText" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed"
                   Text="No EQ2 install was auto-detected. Browse to your EverQuest II folder and pick its 'logs' subfolder (e.g. …\steamapps\common\EverQuest 2\logs)." />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Browse…" Style="{StaticResource GoldButton}" Click="Browse_Click" />
            <TextBlock x:Name="ChosenText" Style="{StaticResource MutedText}" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </StackPanel>

        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12" />
        <Grid>
            <Button Content="Skip for now" Style="{StaticResource GoldButton}" HorizontalAlignment="Left"
                    Click="Skip_Click" ToolTip="You can set the folder any time on the Sources page" />
            <Button x:Name="StartButton" Content="Start parsing" Style="{StaticResource GoldButton}"
                    HorizontalAlignment="Right" Padding="18,6" FontSize="14" IsEnabled="False"
                    Click="Start_Click" />
        </Grid>
    </StackPanel>
</Window>
