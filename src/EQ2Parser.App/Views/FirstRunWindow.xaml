<Window x:Class="EQ2Parser.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EQ2Parser.App.Localization"
        Title="{loc:Tr FirstRun_Welcome}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="{loc:Tr FirstRun_Welcome}" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap"
                   Text="{loc:Tr FirstRun_Intro}" />

        <TextBlock Text="{loc:Tr FirstRun_LogFolder}" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
        <ListBox x:Name="CandidateList" MaxHeight="140" SelectionMode="Single"
                 Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource GoldBrightBrush}" Margin="4,3" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="NoCandidatesText" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed"
                   Text="{loc:Tr FirstRun_NoCandidates}" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{loc:Tr FirstRun_Browse}" Style="{StaticResource GoldButton}" Click="Browse_Click" />
            <TextBlock x:Name="ChosenText" Style="{StaticResource MutedText}" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </StackPanel>

        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12" />
        <Grid>
            <Button Content="{loc:Tr FirstRun_SkipForNow}" Style="{StaticResource GoldButton}" HorizontalAlignment="Left"
                    Click="Skip_Click" ToolTip="{loc:Tr FirstRun_SkipTooltip}" />
            <Button x:Name="StartButton" Content="{loc:Tr FirstRun_StartParsing}" Style="{StaticResource GoldButton}"
                    HorizontalAlignment="Right" Padding="18,6" FontSize="14" IsEnabled="False"
                    Click="Start_Click" />
        </Grid>
    </StackPanel>
</Window>
