<UserControl x:Class="EQ2Parser.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Parsing" Style="{StaticResource SectionLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Combat idle timeout (s)" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding IdleEndSeconds}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Log poll interval (ms)" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PollMilliseconds}" Margin="0,2" />
                </Grid>
                <TextBlock Text="Alerts" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Voice" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                              DisplayMemberPath="DisplayName" Margin="0,2" FontSize="13" />
                    <Button Grid.Column="2" Content="Test" Style="{StaticResource GoldButton}" Margin="8,2,0,2"
                            Padding="12,3" Command="{Binding TestVoiceCommand}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                        <Run Text="Speaking rate " /><Run Text="{Binding TtsRateLabel, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" />
                    </TextBlock>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="2" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" Value="{Binding TtsRate}" VerticalAlignment="Center" Margin="0,6" />

                    <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                        <Run Text="Alert volume " /><Run Text="{Binding AlertVolumeLabel, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" />
                    </TextBlock>
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" Value="{Binding AlertVolume}" VerticalAlignment="Center" Margin="0,6" />
                    <Button Grid.Row="2" Grid.Column="2" Content="♪" Style="{StaticResource GoldButton}" Margin="8,2,0,2"
                            Padding="12,3" ToolTip="Test the chime" Command="{Binding TestChimeCommand}" />
                </Grid>
                <TextBlock Text="{Binding VoiceStatus}" Foreground="{StaticResource GoldBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Neural voices sound dramatically better than the built-in Windows voices below them in the list. Each pack downloads once, works fully offline, and can be removed here any time to reclaim the disk space." />

                <TextBlock Text="Voice packs" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                <ItemsControl ItemsSource="{Binding PackRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource GoldButton}"
                                        Padding="12,3" VerticalAlignment="Center" Margin="10,0,0,0"
                                        IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                                        Command="{Binding DataContext.PackActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Save" Style="{StaticResource GoldButton}" Command="{Binding SaveCommand}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12"
                               Margin="12,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
