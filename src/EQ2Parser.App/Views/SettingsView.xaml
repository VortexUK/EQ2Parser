<UserControl x:Class="EQ2Parser.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:EQ2Parser.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{loc:Tr Settings_Title}" Style="{StaticResource PageTitle}" />
            <!-- Two explicit COLUMNS of stacked cards (not a flat wrap: wrap
                 rows all take the tallest card's height, leaving dead air).
                 The columns themselves wrap under each other when narrow. -->
            <WrapPanel>
                <StackPanel Width="430" Margin="0,0,12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Parsing}" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr Settings_CombatIdleTimeout}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <!-- Wrap on the numeric boxes collapses the Fluent clear (×)
                                 button, which covers the whole value at this width. -->
                            <TextBox Grid.Column="1" Text="{Binding IdleEndSeconds}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="{loc:Tr Settings_LogPollInterval}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PollMilliseconds}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="{loc:Tr Settings_LoadBossesFrom}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr Settings_LoadBossesFromTip}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HistoryBossDays}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="{loc:Tr Settings_KeepTrashFor}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr Settings_KeepTrashForTip}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HistoryTrashDays}" TextWrapping="Wrap" Margin="0,2" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:Tr Settings_Save}" Style="{StaticResource GoldButton}" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12"
                                       Margin="12,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_LexiconSync}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{loc:Tr Settings_SyncNow}" Style="{StaticResource GoldButton}" Padding="12,3"
                                    Command="{Binding LexiconSyncNowCommand}"
                                    ToolTip="{Binding LexiconUrlLabel}" />
                            <TextBlock Text="{Binding LexiconStatus}" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="280" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings_LexiconSyncHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_DetrimentCallouts}" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="{loc:Tr Settings_AnnounceMassDetriments}" IsChecked="{Binding CalloutsEnabled}"
                                  FontSize="12" Margin="0,8,0,0"
                                  ToolTip="{loc:Tr Settings_AnnounceMassDetrimentsTip}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Tr Settings_PlayersBeforeItFires}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr Settings_PlayersBeforeItFiresTip}" />
                            <TextBox Grid.Column="1" Text="{Binding CalloutMinPlayers, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="{loc:Tr Settings_CooldownPerEffect}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr Settings_CooldownPerEffectTip}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalloutCooldown, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_LanguageCard}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="DisplayName" MinWidth="160" FontSize="13" />
                            <TextBlock Text="{Binding LanguageStatus}" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="220" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_About}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding VersionLabel, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}" FontSize="12"
                                       Margin="12,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel Width="430" Margin="0,0,12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_ParseUploads}" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="{loc:Tr Settings_UploadFinishedFights}" IsChecked="{Binding UploadEnabled}"
                                  FontSize="12" Margin="0,8,0,0"
                                  ToolTip="{loc:Tr Settings_UploadFinishedFightsTip}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Settings_ApiToken}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <PasswordBox Grid.Column="1" x:Name="UploadTokenBox" Margin="0,2" FontSize="13" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{loc:Tr Settings_SaveToken}" Style="{StaticResource GoldButton}" Padding="12,3"
                                    Command="{Binding SaveUploadTokenCommand}"
                                    CommandParameter="{Binding ElementName=UploadTokenBox}" />
                            <Button Content="{loc:Tr Settings_Test}" Style="{StaticResource GoldButton}" Padding="12,3" Margin="8,0,0,0"
                                    Command="{Binding TestUploadTokenCommand}" />
                            <Button Content="{loc:Tr Settings_Clear}" Style="{StaticResource GoldButton}" Padding="12,3" Margin="8,0,0,0"
                                    Command="{Binding ClearUploadTokenCommand}" />
                            <TextBlock Text="{Binding UploadTokenState}" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UploadStatus}" Foreground="{StaticResource GoldBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings_ApiTokenHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Alerts}" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{loc:Tr Settings_Voice}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                                      DisplayMemberPath="DisplayName" Margin="0,2" FontSize="13" />
                            <Button Grid.Column="2" Content="{loc:Tr Settings_Test}" Style="{StaticResource GoldButton}" Margin="8,2,0,2"
                                    Padding="12,3" Command="{Binding TestVoiceCommand}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                                <Run Text="{loc:Tr Settings_Rate}" /><Run Text="{Binding TtsRateLabel, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" />
                            </TextBlock>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="2" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" Value="{Binding TtsRate}" VerticalAlignment="Center" Margin="0,6" />

                            <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr Settings_VoiceDepthTip}">
                                <Run Text="{loc:Tr Settings_Depth}" /><Run Text="{Binding VoiceDepthLabel, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" />
                            </TextBlock>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="0.3" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" Value="{Binding VoiceDepthAmount}" VerticalAlignment="Center" Margin="0,6"
                                    ToolTip="{loc:Tr Settings_VoiceDepthTip}" />

                            <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                                <Run Text="{loc:Tr Settings_Volume}" /><Run Text="{Binding AlertVolumeLabel, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" />
                            </TextBlock>
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" Value="{Binding AlertVolume}" VerticalAlignment="Center" Margin="0,6" />
                            <Button Grid.Row="3" Grid.Column="2" Content="♪" Style="{StaticResource GoldButton}" Margin="8,2,0,2"
                                    Padding="12,3" ToolTip="{loc:Tr Settings_TestChimeTip}" Command="{Binding TestChimeCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding VoiceStatus}" Foreground="{StaticResource GoldBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="{loc:Tr Settings_VoicePacks}" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                        <ItemsControl ItemsSource="{Binding PackRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource GoldButton}"
                                                Padding="12,3" VerticalAlignment="Center" Margin="10,0,0,0"
                                                IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                                                Command="{Binding DataContext.PackActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings_VoicePacksHint}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
