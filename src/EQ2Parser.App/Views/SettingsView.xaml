<UserControl x:Class="EQ2Parser.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <!-- Two explicit COLUMNS of stacked cards (not a flat wrap: wrap
                 rows all take the tallest card's height, leaving dead air).
                 The columns themselves wrap under each other when narrow. -->
            <WrapPanel>
                <StackPanel Width="430" Margin="0,0,12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Parsing" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Combat idle timeout (s)" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <!-- Wrap on the numeric boxes collapses the Fluent clear (×)
                                 button, which covers the whole value at this width. -->
                            <TextBox Grid.Column="1" Text="{Binding IdleEndSeconds}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Log poll interval (ms)" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PollMilliseconds}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="Load bosses from (days)" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="Named fights newer than this load at startup. Older ones stay in the archive forever — pull them back from the Archive window on the Main page." />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HistoryBossDays}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="Keep trash for (days)" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="Non-named fights are deleted for good past this window" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HistoryTrashDays}" TextWrapping="Wrap" Margin="0,2" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save" Style="{StaticResource GoldButton}" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12"
                                       Margin="12,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Lexicon sync" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Sync now" Style="{StaticResource GoldButton}" Padding="12,3"
                                    Command="{Binding LexiconSyncNowCommand}"
                                    ToolTip="{Binding LexiconUrlLabel}" />
                            <TextBlock Text="{Binding LexiconStatus}" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="280" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Curated triggers and timers from EQ2Lexicon appear as a read-only Lexicon section on the Triggers and Timers pages. Syncs automatically at startup; enable/disable choices stick across syncs." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Parse uploads" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="Upload finished fights to EQ2Lexicon" IsChecked="{Binding UploadEnabled}"
                                  FontSize="12" Margin="0,8,0,0"
                                  ToolTip="Every finished fight uploads in the background. The site keeps named (boss) kills for parses and rankings; trash fights are cleared automatically after a few days.&#10;Needs a saved API token below." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API token" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <PasswordBox Grid.Column="1" x:Name="UploadTokenBox" Margin="0,2" FontSize="13" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Save token" Style="{StaticResource GoldButton}" Padding="12,3"
                                    Command="{Binding SaveUploadTokenCommand}"
                                    CommandParameter="{Binding ElementName=UploadTokenBox}" />
                            <Button Content="Test" Style="{StaticResource GoldButton}" Padding="12,3" Margin="8,0,0,0"
                                    Command="{Binding TestUploadTokenCommand}" />
                            <Button Content="Clear" Style="{StaticResource GoldButton}" Padding="12,3" Margin="8,0,0,0"
                                    Command="{Binding ClearUploadTokenCommand}" />
                            <TextBlock Text="{Binding UploadTokenState}" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UploadStatus}" Foreground="{StaticResource GoldBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Create a token on the EQ2Lexicon site (sign in with Discord → account menu → API tokens), paste it here, Save, then Test. It's stored encrypted for this Windows user only. You can also right-click any fight in the tree to upload it on demand." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Detriment callouts" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="Announce mass detriments" IsChecked="{Binding CalloutsEnabled}"
                                  FontSize="12" Margin="0,8,0,0"
                                  ToolTip="When several players get hit by the same control effect at once, speak it — “8 players stunned”.&#10;Detected straight from the log's status lines; no per-boss setup needed." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Players before it fires" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="Distinct players hit within a few seconds before the callout fires. Higher = raid-wide AoEs only; 1 = every CC on anyone." />
                            <TextBox Grid.Column="1" Text="{Binding CalloutMinPlayers, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Cooldown per effect (s)" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="Quiet period after a callout for that effect — one stun wave is one call, not a stream." />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalloutCooldown, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding VersionLabel, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}" FontSize="12"
                                       Margin="12,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel Width="430" Margin="0,0,12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Alerts" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Voice" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                                      DisplayMemberPath="DisplayName" Margin="0,2" FontSize="13" />
                            <Button Grid.Column="2" Content="Test" Style="{StaticResource GoldButton}" Margin="8,2,0,2"
                                    Padding="12,3" Command="{Binding TestVoiceCommand}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                                <Run Text="Rate " /><Run Text="{Binding TtsRateLabel, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" />
                            </TextBlock>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="2" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" Value="{Binding TtsRate}" VerticalAlignment="Center" Margin="0,6" />

                            <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                                <Run Text="Volume " /><Run Text="{Binding AlertVolumeLabel, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" />
                            </TextBlock>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" Value="{Binding AlertVolume}" VerticalAlignment="Center" Margin="0,6" />
                            <Button Grid.Row="2" Grid.Column="2" Content="♪" Style="{StaticResource GoldButton}" Margin="8,2,0,2"
                                    Padding="12,3" ToolTip="Test the chime" Command="{Binding TestChimeCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding VoiceStatus}" Foreground="{StaticResource GoldBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="Voice packs" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                        <ItemsControl ItemsSource="{Binding PackRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource GoldButton}"
                                                Padding="12,3" VerticalAlignment="Center" Margin="10,0,0,0"
                                                IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                                                Command="{Binding DataContext.PackActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Neural voices sound dramatically better than the built-in Windows voices below them in the list. Each pack downloads once, works fully offline, and can be removed here any time to reclaim the disk space." />
                    </StackPanel>
                </Border>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
