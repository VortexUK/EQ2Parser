<UserControl x:Class="EQ2Parser.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Encounter History" Style="{StaticResource PageTitle}" />
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <ListBox ItemsSource="{Binding Encounters}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                               FontFamily="{StaticResource BodySemiBoldFont}" FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBlock Text=" · " Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBlock Text="{Binding Zone}" Style="{StaticResource MutedText}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        <TextBlock Text=" · " Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBlock Text="{Binding Duration}" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBlock Text="{Binding SourceCount, StringFormat=' · {0}'}" Foreground="{StaticResource GoldBrush}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Dps}" Foreground="{StaticResource GoldBrightBrush}"
                                               FontFamily="{StaticResource BodySemiBoldFont}" FontSize="14" TextAlignment="Right" />
                                    <TextBlock Text="{Binding Outcome}" FontSize="11" TextAlignment="Right"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Breakdown" Style="{StaticResource PageTitle}" />
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MeterRowTemplate}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
